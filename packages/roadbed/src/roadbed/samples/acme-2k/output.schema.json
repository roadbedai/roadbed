{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claims triage output",
  "description": "Output of the claims-triage model and the reviewer verdict. SYNTHETIC fixture task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "severity"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "fast_track",
        "standard",
        "complex",
        "siu"
      ],
      "description": "Queue the claim goes to."
    },
    "severity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Severity, 1 (low) to 5 (high)."
    }
  }
}
