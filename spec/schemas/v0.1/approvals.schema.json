{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/approvals.schema.json",
  "$defs": {
    "ApprovalEntry": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "validator",
            "approver"
          ],
          "title": "Role",
          "type": "string"
        },
        "decision": {
          "enum": [
            "validated",
            "validated_with_findings",
            "approved",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "no_findings",
            "findings_noted",
            "low_n_slices",
            "slice_regression",
            "license_review",
            "contamination_risk",
            "cost_over_cap",
            "other"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "refs": {
          "description": "Ids the decision rests on. No free text.",
          "items": {
            "description": "A finding, correction test, audit seq or rebase id.",
            "pattern": "^(F-\\d{4}|CT-\\d{4,}|audit:\\d+|rebase:\\d+)$",
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "audit_seq": {
          "minimum": 1,
          "title": "Audit Seq",
          "type": "integer"
        },
        "pack_version": {
          "description": "Evidence pack version this approval signed.",
          "minimum": 1,
          "title": "Pack Version",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "decision",
        "reason_code",
        "at",
        "audit_seq",
        "pack_version"
      ],
      "title": "ApprovalEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "rebases/<n>/evidence/approvals.json.",
  "properties": {
    "spec": {
      "const": "roadbed/v0.1",
      "description": "Spec version of this file.",
      "title": "Spec",
      "type": "string"
    },
    "rebase": {
      "title": "Rebase",
      "type": "integer"
    },
    "status": {
      "enum": [
        "awaiting_signoff",
        "approved",
        "rejected",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_text": {
      "description": "Display text, e.g. 'awaiting MRM sign-off'.",
      "title": "Status Text",
      "type": "string"
    },
    "required": {
      "items": {
        "enum": [
          "validator",
          "approver"
        ],
        "type": "string"
      },
      "title": "Required",
      "type": "array"
    },
    "pack_version": {
      "description": "Each approval writes a new signed pack version.",
      "minimum": 1,
      "title": "Pack Version",
      "type": "integer"
    },
    "approvals": {
      "additionalProperties": false,
      "description": "Keyed by actor id, so one actor holds one role: validator and approver differ (SoD-03).",
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]{0,63}$": {
          "$ref": "#/$defs/ApprovalEntry"
        }
      },
      "propertyNames": {
        "description": "User or service id (lowercase, digits, _ and -). Never an email address or a name."
      },
      "title": "Approvals",
      "type": "object"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "spec",
    "rebase",
    "status",
    "status_text",
    "required",
    "pack_version",
    "approvals",
    "synthetic"
  ],
  "title": "approvals.json",
  "type": "object"
}
