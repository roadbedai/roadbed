{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/gate-policy.schema.json",
  "$defs": {
    "ContaminationPolicy": {
      "additionalProperties": false,
      "properties": {
        "minhash_threshold": {
          "description": "Near-duplicate when MinHash Jaccard >= this. Plan value 0.8.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Minhash Threshold",
          "type": "number"
        },
        "num_perm": {
          "description": "MinHash permutations.",
          "minimum": 16,
          "title": "Num Perm",
          "type": "integer"
        },
        "shingle": {
          "description": "Word shingle size.",
          "minimum": 1,
          "title": "Shingle",
          "type": "integer"
        }
      },
      "required": [
        "minhash_threshold",
        "num_perm",
        "shingle"
      ],
      "title": "ContaminationPolicy",
      "type": "object"
    },
    "CostCap": {
      "additionalProperties": false,
      "properties": {
        "eur": {
          "description": "Abort the rebase when its cost reaches this many euros.",
          "exclusiveMinimum": 0,
          "title": "Eur",
          "type": "number"
        },
        "gpu_hours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional. Abort at this many GPU-hours.",
          "title": "Gpu Hours"
        }
      },
      "required": [
        "eur"
      ],
      "title": "CostCap",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "stub": {
          "description": "True when the stage is a placeholder and does not run.",
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stub"
      ],
      "title": "Stage",
      "type": "object"
    },
    "Stages": {
      "additionalProperties": false,
      "properties": {
        "shadow": {
          "$ref": "#/$defs/Stage"
        },
        "canary": {
          "$ref": "#/$defs/Stage"
        },
        "bias_tests": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "shadow",
        "canary",
        "bias_tests"
      ],
      "title": "Stages",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "policy/gate.yaml.",
  "properties": {
    "margin": {
      "description": "Block when a slice delta is below this (score points).",
      "title": "Margin",
      "type": "number"
    },
    "min_n": {
      "description": "Slices with fewer rows are flagged low_n and never block.",
      "minimum": 1,
      "title": "Min N",
      "type": "integer"
    },
    "ci": {
      "description": "Confidence level of the percentile bootstrap CI.",
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Ci",
      "type": "number"
    },
    "n_boot": {
      "description": "Bootstrap resamples.",
      "minimum": 100,
      "title": "N Boot",
      "type": "integer"
    },
    "seed": {
      "description": "Seed for the bootstrap RNG.",
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "block_on": {
      "description": "Failed checks with these reasons block the rebase.",
      "items": {
        "enum": [
          "slice_below_margin",
          "contamination",
          "license_denied"
        ],
        "type": "string"
      },
      "title": "Block On",
      "type": "array"
    },
    "stages": {
      "$ref": "#/$defs/Stages"
    },
    "cost_cap": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostCap"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional. Cost cap per rebase."
    },
    "contamination": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContaminationPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional. Near-duplicate settings."
    },
    "synthetic": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True when part of a synthetic asset repo.",
      "title": "Synthetic"
    }
  },
  "required": [
    "margin",
    "min_n",
    "ci",
    "n_boot",
    "seed",
    "block_on",
    "stages"
  ],
  "title": "gate.yaml (policy)",
  "type": "object"
}
