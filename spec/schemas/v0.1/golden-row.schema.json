{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/golden-row.schema.json",
  "additionalProperties": false,
  "description": "One line of evals/golden.jsonl.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "slices": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Slices",
      "type": "object"
    },
    "input_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Ref",
      "type": "string"
    },
    "expected": {
      "additionalProperties": true,
      "title": "Expected",
      "type": "object"
    },
    "row_hash": {
      "anyOf": [
        {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Hash"
    }
  },
  "required": [
    "id",
    "slices",
    "input_ref",
    "expected"
  ],
  "title": "Golden row",
  "type": "object"
}
