{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/snapshot-row.schema.json",
  "additionalProperties": false,
  "description": "One line of a snapshot part: a resolved verdict row. Training reads these.",
  "properties": {
    "interaction_id": {
      "minLength": 1,
      "title": "Interaction Id",
      "type": "string"
    },
    "input_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Ref",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "description": "Model output at capture time.",
      "title": "Output",
      "type": "object"
    },
    "verdict": {
      "additionalProperties": true,
      "description": "Resolved label. Validates against task.output_schema.",
      "title": "Verdict",
      "type": "object"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "outcome": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Late system-of-record outcome, if any.",
      "title": "Outcome"
    },
    "ts": {
      "description": "Verdict time.",
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "slices": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Slices",
      "type": "object"
    },
    "row_hash": {
      "description": "sha256(JCS({interaction_id, input_ref, output, verdict, reason_code, outcome, ts})).",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Row Hash",
      "type": "string"
    }
  },
  "required": [
    "interaction_id",
    "input_ref",
    "output",
    "verdict",
    "ts",
    "slices",
    "row_hash"
  ],
  "title": "Snapshot row",
  "type": "object"
}
