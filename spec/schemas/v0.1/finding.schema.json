{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/finding.schema.json",
  "description": "findings/F-NNNN.yaml. Day 0 shape plus optional status and kind.",
  "properties": {
    "id": {
      "pattern": "^F-\\d{4}$",
      "title": "Id",
      "type": "string"
    },
    "rebase": {
      "title": "Rebase",
      "type": "integer"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "slice_below_margin",
            "contamination",
            "license_denied",
            "seal_order",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The failure reason of the check that raised it.",
      "title": "Kind"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "open",
            "accepted",
            "resolved"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "slice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "key=value",
      "title": "Slice"
    },
    "n": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N"
    },
    "delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delta"
    },
    "ci_low": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ci Low"
    },
    "ci_high": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ci High"
    },
    "margin": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Margin"
    },
    "gate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path of the gate.json that raised it.",
      "title": "Gate"
    },
    "placeholder": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "True for a reserved id with no numbers.",
      "title": "Placeholder"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ids and plain facts only; never personal data.",
      "title": "Note"
    },
    "synthetic": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Synthetic"
    }
  },
  "required": [
    "id",
    "rebase"
  ],
  "title": "Finding (findings/F-NNNN.yaml)",
  "type": "object",
  "additionalProperties": false
}
