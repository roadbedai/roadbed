{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/holdout-row.schema.json",
  "additionalProperties": false,
  "description": "One line of data/holdout/<id>/holdout.jsonl.",
  "properties": {
    "id": {
      "description": "Stable row id, e.g. clm-000001.",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "slices": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Slice key to slice value, e.g. {line: bodily_injury}.",
      "title": "Slices",
      "type": "object"
    },
    "input_ref": {
      "description": "Content address of the input; the raw input is not stored in the holdout.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Ref",
      "type": "string"
    },
    "expected": {
      "additionalProperties": true,
      "description": "Reviewer verdict. Must validate against task.output_schema.",
      "title": "Expected",
      "type": "object"
    },
    "row_hash": {
      "anyOf": [
        {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional. Row hash of the source verdict row (see SPEC.md, hashing). When absent, sha256(JCS(row)).",
      "title": "Row Hash"
    }
  },
  "required": [
    "id",
    "slices",
    "input_ref",
    "expected"
  ],
  "title": "Holdout row",
  "type": "object"
}
