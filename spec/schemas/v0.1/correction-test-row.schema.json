{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/correction-test-row.schema.json",
  "additionalProperties": false,
  "description": "One line of evals/correction_tests.jsonl: one per reviewer fix.",
  "properties": {
    "id": {
      "pattern": "^CT-\\d{4,}$",
      "title": "Id",
      "type": "string"
    },
    "interaction_id": {
      "title": "Interaction Id",
      "type": "string"
    },
    "input_ref": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Ref",
      "type": "string"
    },
    "slices": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Slices",
      "type": "object"
    },
    "model_version": {
      "description": "Version that produced the wrong output.",
      "title": "Model Version",
      "type": "string"
    },
    "model_output": {
      "additionalProperties": true,
      "title": "Model Output",
      "type": "object"
    },
    "expected": {
      "additionalProperties": true,
      "description": "Reviewer fix.",
      "title": "Expected",
      "type": "object"
    },
    "reason_code": {
      "title": "Reason Code",
      "type": "string"
    },
    "created_by": {
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "row_hash": {
      "anyOf": [
        {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Row Hash"
    }
  },
  "required": [
    "id",
    "interaction_id",
    "input_ref",
    "slices",
    "model_version",
    "model_output",
    "expected",
    "reason_code",
    "created_by",
    "created_at"
  ],
  "title": "Correction test row",
  "type": "object"
}
