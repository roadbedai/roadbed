{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/evidence-manifest.schema.json",
  "$defs": {
    "ManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "path": {
          "description": "Path from asset root.",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "path"
      ],
      "title": "ManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Parsed form of a MANIFEST.sha256 text file (rebase or evidence): one entry per '<sha256>  <path>' line.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/ManifestEntry"
      },
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "entries"
  ],
  "title": "MANIFEST.sha256 (parsed)",
  "type": "object"
}
