{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roadbedai/roadbed/blob/main/spec/schemas/v0.1/approval.schema.json",
  "additionalProperties": false,
  "description": "One sign-off. Also the response of POST /v1/rebases/{n}/approvals.",
  "properties": {
    "role": {
      "enum": [
        "validator",
        "approver"
      ],
      "title": "Role",
      "type": "string"
    },
    "decision": {
      "enum": [
        "validated",
        "validated_with_findings",
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "no_findings",
        "findings_noted",
        "low_n_slices",
        "slice_regression",
        "license_review",
        "contamination_risk",
        "cost_over_cap",
        "other"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "refs": {
      "description": "Ids the decision rests on. No free text.",
      "items": {
        "description": "A finding, correction test, audit seq or rebase id.",
        "pattern": "^(F-\\d{4}|CT-\\d{4,}|audit:\\d+|rebase:\\d+)$",
        "type": "string"
      },
      "title": "Refs",
      "type": "array"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "audit_seq": {
      "minimum": 1,
      "title": "Audit Seq",
      "type": "integer"
    },
    "pack_version": {
      "description": "Evidence pack version this approval signed.",
      "minimum": 1,
      "title": "Pack Version",
      "type": "integer"
    },
    "rebase": {
      "title": "Rebase",
      "type": "integer"
    },
    "actor": {
      "description": "User or service id (lowercase, digits, _ and -). Never an email address or a name.",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Actor",
      "type": "string"
    }
  },
  "required": [
    "role",
    "decision",
    "reason_code",
    "at",
    "audit_seq",
    "pack_version",
    "rebase",
    "actor"
  ],
  "title": "Approval",
  "type": "object"
}
